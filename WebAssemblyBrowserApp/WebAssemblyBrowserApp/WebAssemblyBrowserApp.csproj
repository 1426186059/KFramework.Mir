<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <StaticWebAssetFingerprintPattern Include="JS" Pattern="*.js" Expression="#[.{fingerprint}]!" />
  </ItemGroup>

  <ItemGroup>
    <!-- 浏览器 WASM 无 DirectX / Vulkan：这些硬件管线无法使用，渲染由
         Mir3/RenderingCore/Rendering/CanvasRenderingPipeline.cs + JSBind/CanvasRenderer.cs 接管。 -->
    <Compile Remove="Mir3\RenderingCore\Rendering\SharpDXD3D9\**" />
    <Compile Remove="Mir3\RenderingCore\Rendering\SharpDXD3D11\**" />
    <Compile Remove="Mir3\RenderingCore\Rendering\SilkD3D11\**" />
    <Compile Remove="Mir3\RenderingCore\Rendering\SilkVulkan\**" />
  </ItemGroup>
</Project>
